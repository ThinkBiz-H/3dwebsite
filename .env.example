# Firebase (Project settings -> General -> Your apps -> SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (Dashboard -> Settings -> Upload -> Upload presets; preset must be "Unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Public site URL, used for canonical/OG tags and sitemap/RSS generation
VITE_SITE_URL=https://lumenledger.com
